# ---------------------------------------------------------------------------
# CodeBridge AI - copy to .env and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Database. PostgreSQL in production, SQLite is the zero-setup local default.
# DATABASE_URL=postgresql+psycopg2://codebridge:codebridge@localhost:5432/codebridge
DATABASE_URL=sqlite:///./codebridge.db

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI provider: "openai" or "gemini". Only the selected provider's key is required.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT=120

# Sandbox limits
DOCKER_EXECUTION_ENABLED=true
# "uid:gid" the sandbox container runs as. Leave empty to use the current user on
# POSIX or 1000:1000 on Windows (os.getuid/os.getgid do not exist there).
DOCKER_CONTAINER_USER=
MAX_EXECUTION_TIME=10
MAX_MEMORY_MB=256
MAX_CODE_SIZE_KB=500
MAX_OUTPUT_CHARS=20000
MAX_PROCESSES=128

# Verification / correction
MAX_CORRECTION_ATTEMPTS=3
MAX_GENERATED_TEST_CASES=10

# Output comparison. Numeric tolerance is OFF by default: turning 3.0 into 3 is
# an observable behavior change. Enable only for a target whose float formatting
# genuinely differs from the source language.
VERIFICATION_NUMERIC_TOLERANCE=false
VERIFICATION_NUMERIC_REL_TOLERANCE=1e-9
VERIFICATION_NUMERIC_ABS_TOLERANCE=1e-9

# CORS. Comma-separated or a JSON array. The localhost dev origins are only
# applied outside production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth endpoint rate limiting (per client IP).
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ENABLED=true
# Only enable behind a proxy you control that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

LOG_LEVEL=INFO

# Frontend (frontend/.env)
# VITE_API_BASE_URL=http://localhost:8000
